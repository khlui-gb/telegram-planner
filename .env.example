# Copy this file to .env and fill in your real values.
# .env itself is git-ignored and must never be committed.

# From @BotFather on Telegram (/newbot)
TELEGRAM_BOT_TOKEN=your-token-from-botfather

# Your numeric Telegram user ID. Message your bot, then open
#   https://api.telegram.org/bot<TOKEN>/getUpdates
# and read message.from.id. Anyone NOT on this list is ignored silently.
ALLOWED_USER_ID=your-numeric-telegram-user-id

# From https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-openai-key

# The brain. gpt-5-nano is the cheapest GPT ($0.05/$0.40 per 1M tokens).
# IMPORTANT: gpt-5-nano rejects temperature/top_p/penalties, so app.py never
# sends them. If date parsing disappoints, change this one line to
# gpt-4o-mini and restart. No code change needed.
MODEL=gpt-5-nano

# Optional. Leave blank for the normal OpenAI endpoint.
OPENAI_BASE_URL=
